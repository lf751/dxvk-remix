#pragma once

// Terrain relief payloads store distance, material LOD, hit marker and mask LOD or packed palette RGB.
static const float kTerrainHeightHitMarker = -1.f;

vec4 terrainSharedTextureCoord(SurfaceInteraction interaction, bool hasRelief) {
#ifdef TERRAIN_BLEND
  if (hasRelief) {
    return vec4(interaction.textureCoordinates, kTerrainHeightHitMarker, interaction.terrainPaletteSample);
  }
#endif
  return vec4(interaction.textureCoordinates, 0.f, 0.f);
}

bool terrainSharedTextureCoordHasHeight(vec4 coordinates) {
  return coordinates.z == kTerrainHeightHitMarker;
}

#include "rtx/pass/terrain_pom_math.h"

vec3 terrainProjectionWeights(vec3 normal) {
  const vec3 weights = pow(abs(normal), vec3(4.f));
  return weights / max(dot(weights, vec3(1.f)), 1e-6f);
}

void terrainProjectionBasis(vec3 normal, uint axis, out vec3 tangent, out vec3 bitangent) {
  const float side = normal[axis] < 0.f ? -1.f : 1.f;
  tangent = axis == 0 ? vec3(0.f, 0.f, 1.f) : vec3(1.f, 0.f, 0.f);
  bitangent = axis == 0 ? vec3(0.f, -side, 0.f) :
    (axis == 1 ? vec3(0.f, 0.f, -side) : vec3(0.f, side, 0.f));
}

float terrainLayerHeight(TerrainBlendLayerArgs layer, vec3 position, vec3 normal, float lod) {
  if (layer.heightTextureIndex == BINDING_INDEX_INVALID) {
    return 0.5f;
  }
  const vec3 projections = terrainProjectionWeights(normal);
  float height = 0.f;
  for (uint axis = 0; axis < 3; ++axis) {
    if (projections[axis] == 0.f) {
      continue;
    }
    vec3 tangent, bitangent;
    terrainProjectionBasis(normal, axis, tangent, bitangent);
    const vec2 uv = vec2(dot(position, tangent), dot(position, bitangent)) / layer.unitsPerRepeat;
    height += textures[nonuniformEXT(layer.heightTextureIndex)]
      .SampleLevel(samplers[nonuniformEXT(layer.samplerIndex)], uv, lod).r * projections[axis];
  }
  return sanitize(height, 0.5f);
}

float terrainCoverageDirt(TerrainBlendArgs args, vec3 position) {
  if (args.dirtStrength <= 0.f || args.coverageTextureIndex == BINDING_INDEX_INVALID) {
    return 0.f;
  }
  // Uses the coverage projection independently of material tiling.
  const vec2 plane = args.zUp ? position.xy : position.xz;
  const vec2 uv = plane * args.coverageUvScale;
  const float radius = args.dirtWidth * args.coverageUvScale;
  float coverage = 0.f;
  for (int y = -1; y <= 1; ++y) {
    for (int x = -1; x <= 1; ++x) {
      coverage += textures[nonuniformEXT(args.coverageTextureIndex)]
        .SampleLevel(samplers[nonuniformEXT(args.maskSamplerIndex)], uv + vec2(x, y) * radius, 0).a;
    }
  }
  return saturate((1.f - coverage * (1.f / 9.f)) * 2.f) * args.dirtStrength;
}

static const uint kTerrainGrass = 0;
static const uint kTerrainSand = 1;
static const uint kTerrainRock = 2;
static const uint kTerrainDirt = 3;
static const uint kTerrainDeadGrass = 4;

struct TerrainWeights {
  float values[kTerrainBlendLayerCount];
};

TerrainWeights terrainControlWeights(vec4 channels) {
  const vec4 mask = saturate(channels);
  const float total = dot(mask, vec4(1.f));
  const float scale = rcp(max(total, 1.f));
  TerrainWeights weights;
  weights.values[kTerrainGrass] = mask.r * scale;
  weights.values[kTerrainDeadGrass] = mask.g * scale;
  weights.values[kTerrainDirt] = mask.b * scale;
  weights.values[kTerrainRock] = mask.a * scale;
  weights.values[kTerrainSand] = saturate(1.f - total);
  weights.values[kTerrainPeakRockLayer] = 0.f;
  weights.values[kTerrainLowerRockLayer] = 0.f;
  return weights;
}

vec3 terrainUnpackPaletteSample(float packed) {
  const uint bits = uint(packed);
  return vec3((bits >> 16) & 255u, (bits >> 8) & 255u, bits & 255u) / 255.f;
}

float terrainHash2D(vec2 cell) {
  vec3 p = fract(vec3(cell.x, cell.y, cell.x) * 0.1031f);
  p += dot(p, p.yzx + 33.33f);
  return fract((p.x + p.y) * p.z);
}

float terrainValueNoise(vec2 p) {
  const vec2 i = floor(p);
  const vec2 f = fract(p);
  const vec2 u = f * f * (3.f - 2.f * f);
  const float a = terrainHash2D(i);
  const float b = terrainHash2D(i + vec2(1.f, 0.f));
  const float c = terrainHash2D(i + vec2(0.f, 1.f));
  const float d = terrainHash2D(i + vec2(1.f, 1.f));
  return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float terrainFbm3(vec2 p, float periodA, float periodB, float periodC, vec2 seedOffset) {
  return 0.50f * terrainValueNoise(p / periodA + seedOffset)
       + 0.31f * terrainValueNoise(p / periodB + seedOffset * 1.73f + vec2(17.1f, 31.7f))
       + 0.19f * terrainValueNoise(p / periodC + seedOffset * 2.41f + vec2(53.3f, 11.9f));
}

float terrainRockWeight(TerrainBlendArgs args, vec3 up, vec3 normal, float worldElevation, vec2 plane) {
  // Organic ridge/gully variation lets rocky spurs descend farther while sheltered valleys hold soil higher up.
  const float outcrop = terrainFbm3(plane, 42.f, 17.f, 7.5f, vec2(13.7f, 29.3f)) - 0.5f;
  const float cosAngle = saturate(abs(dot(normal, up)) - outcrop * 0.08f);
  const float slope = saturate((cosAngle - args.slopeCosStart) / (args.slopeCosEnd - args.slopeCosStart));
  const float slopeRock = slope * slope * (3.f - 2.f * slope);
  const float elevationRock = smoothstep(args.rockLowElevation, args.rockHighElevation, worldElevation + outcrop * 3.4f);
  return !args.rockMode ? slopeRock : (args.rockMode == 1 ? elevationRock :
    1.f - (1.f - slopeRock) * (1.f - elevationRock));
}

void terrainTransferVegetation(float fraction, uint destination, inout TerrainWeights weights) {
  const float vegetation = weights.values[kTerrainGrass] + weights.values[kTerrainDeadGrass];
  weights.values[kTerrainGrass] *= 1.f - fraction;
  weights.values[kTerrainDeadGrass] *= 1.f - fraction;
  weights.values[destination] += vegetation * fraction;
}

void terrainApplyDirtCoverage(TerrainBlendArgs args, vec3 position, float worldElevation, inout TerrainWeights weights) {
  const float vegetation = weights.values[kTerrainGrass] + weights.values[kTerrainDeadGrass];
  const float rockSuppression = 1.f - smoothstep(0.45f, 0.90f, weights.values[kTerrainRock]);
  if (vegetation <= 0.f || worldElevation <= args.dirtMinElevation || rockSuppression <= 0.f) {
    return;
  }
  const float coverage = terrainCoverageDirt(args, position) * rockSuppression *
    smoothstep(args.dirtMinElevation, args.dirtMinElevation + args.dirtElevationFadeWidth, worldElevation);
  terrainTransferVegetation(coverage, kTerrainDirt, weights);
}

void terrainApplyOrganicGroundBreakup(TerrainBlendArgs args, vec2 plane, float worldElevation, inout TerrainWeights weights) {
  const float inland = smoothstep(args.lowElevation, args.highElevation + 0.8f, worldElevation);
  const float rockSuppression = 1.f - smoothstep(0.45f, 0.88f, weights.values[kTerrainRock]);
  const float mask = inland * rockSuppression;
  if (mask <= 0.f) {
    return;
  }
  // Procedural equivalent of the organic moisture/soil mask so every island gets natural grass, dry grass, and earth breakup.
  const float moisture = terrainFbm3(plane, 58.f, 22.f, 8.5f, vec2(4.3f, 9.1f));
  const float soil = terrainFbm3(plane, 34.f, 14.f, 5.8f, vec2(41.2f, 19.8f));
  const float hillBoost = smoothstep(2.5f, 11.f, worldElevation);

  const float grass = weights.values[kTerrainGrass];
  const float withered = grass * (0.58f + 0.16f * hillBoost) * (1.f - smoothstep(0.32f, 0.54f, moisture)) * mask;
  const float exposed = (grass - withered) * (0.48f + 0.24f * hillBoost) * smoothstep(0.52f, 0.74f, soil) * mask;
  weights.values[kTerrainGrass] = grass - withered - exposed;
  weights.values[kTerrainDeadGrass] += withered;
  weights.values[kTerrainDirt] += exposed;

  const float eroded = weights.values[kTerrainDeadGrass] * 0.42f * smoothstep(0.46f, 0.70f, soil) * mask;
  weights.values[kTerrainDeadGrass] -= eroded;
  weights.values[kTerrainDirt] += eroded;
}

void terrainFinishBaseWeights(TerrainBlendArgs args, vec3 position, float worldElevation, float upFacing,
    inout TerrainWeights weights) {
  const vec2 plane = args.zUp ? position.xy : position.xz;
  terrainApplyDirtCoverage(args, position, worldElevation, weights);
  if (args.controlTextureIndex == BINDING_INDEX_INVALID) {
    terrainApplyOrganicGroundBreakup(args, plane, worldElevation, weights);
  }
  // Natural weathered soil/scree apron along the transition band where rock emerges from vegetation.
  const float rockWeight = weights.values[kTerrainRock];
  const float talusBand = 4.f * rockWeight * (1.f - rockWeight) *
    smoothstep(args.lowElevation, args.highElevation + 1.5f, worldElevation);
  if (talusBand > 0.f) {
    terrainTransferVegetation(talusBand * 0.48f, kTerrainDirt, weights);
  }
  const float peakRange = args.peakRockHighElevation - args.peakRockLowElevation;
  if (peakRange > 0.f) {
    // Upper summit crests exclude lower-elevation vegetation and dirt while steep flanks retain cliff rock slightly higher.
    const float elevation = worldElevation - (1.f - upFacing) * peakRange * 0.25f;
    const float summit = smoothstep(args.peakRockLowElevation, args.peakRockHighElevation, elevation);
    if (summit > 0.f) {
      const float clearSoil = smoothstep(0.15f, 0.80f, summit);
      const float cleared = (weights.values[kTerrainGrass] + weights.values[kTerrainDeadGrass] +
        weights.values[kTerrainDirt] + weights.values[kTerrainSand]) * clearSoil;
      weights.values[kTerrainGrass] *= 1.f - clearSoil;
      weights.values[kTerrainDeadGrass] *= 1.f - clearSoil;
      weights.values[kTerrainDirt] *= 1.f - clearSoil;
      weights.values[kTerrainSand] *= 1.f - clearSoil;
      weights.values[kTerrainRock] += cleared;
      weights.values[kTerrainPeakRockLayer] = weights.values[kTerrainRock] * summit;
      weights.values[kTerrainRock] -= weights.values[kTerrainPeakRockLayer];
    }
  }
  const float lowerRange = args.lowerRockHighElevation - args.lowerRockLowElevation;
  if (lowerRange > 0.f && weights.values[kTerrainRock] > 0.f) {
    // Grassy lower mountain rock bridges foothills into bare mid-elevation cliff rock.
    const float lowerElevation = worldElevation + (1.f - upFacing) * lowerRange * 0.25f;
    const float lowerFraction = 1.f - smoothstep(args.lowerRockLowElevation, args.lowerRockHighElevation, lowerElevation);
    weights.values[kTerrainLowerRockLayer] = weights.values[kTerrainRock] * lowerFraction;
    weights.values[kTerrainRock] -= weights.values[kTerrainLowerRockLayer];
  }
}

TerrainWeights terrainBaseWeights(vec3 position, vec3 normal, float paletteSample) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  const vec3 up = args.zUp ? vec3(0.f, 0.f, 1.f) : vec3(0.f, 1.f, 0.f);
  const float worldElevation = dot(position, up) * (args.flipElevation ? -1.f : 1.f);
  const vec2 plane = args.zUp ? position.xy : position.xz;
  if (args.controlTextureIndex != BINDING_INDEX_INVALID) {
    const vec2 uv = plane * args.controlWorldToUv.xy + args.controlWorldToUv.zw;
    const vec4 mask = textures[nonuniformEXT(args.controlTextureIndex)].SampleLevel(
      samplers[nonuniformEXT(args.maskSamplerIndex)], uv, paletteSample);
    TerrainWeights weights = terrainControlWeights(mask);
    if (args.rockMode != 0) {
      terrainTransferVegetation(terrainRockWeight(args, up, normal, worldElevation, plane), kTerrainRock, weights);
    }
    terrainFinishBaseWeights(args, position, worldElevation, abs(dot(normal, up)), weights);
    return weights;
  }
  const float elevation = smoothstep(args.lowElevation, args.highElevation, worldElevation);
  const float rock = terrainRockWeight(args, up, normal, worldElevation, plane);
  TerrainWeights weights;
  weights.values[kTerrainGrass] = elevation * (1.f - rock);
  weights.values[kTerrainSand] = (1.f - elevation) * (1.f - rock);
  weights.values[kTerrainRock] = rock;
  weights.values[kTerrainDirt] = 0.f;
  weights.values[kTerrainDeadGrass] = 0.f;
  weights.values[kTerrainPeakRockLayer] = 0.f;
  weights.values[kTerrainLowerRockLayer] = 0.f;

  if (paletteSample > 0.f && args.paletteStrength > 0.f) {
    const vec3 color = terrainUnpackPaletteSample(paletteSample);
    const float confidence = smoothstep(0.f, 0.08f, max(color.r, max(color.g, color.b)));
    TerrainWeights distances;
    float nearest = 3.f;
    for (uint layer = 0; layer < kTerrainBlendMaskLayerCount; ++layer) {
      const vec3 difference = color - args.layers[layer].maskColor.rgb;
      distances.values[layer] = dot(difference, difference);
      nearest = min(nearest, distances.values[layer]);
    }
    const float spread = max(args.paletteSoftness, 1.f / 255.f);
    const float inverseSpreadSquared = rcp(spread * spread);
    TerrainWeights scores;
    for (uint layer = 0; layer < kTerrainBlendMaskLayerCount; ++layer) {
      // Offset the distances so at least one score stays representable at narrow widths.
      const float difference = distances.values[layer] - nearest;
      scores.values[layer] = exp2(-difference * inverseSpreadSquared);
    }
    const float rockExclusion = smoothstep(0.45f, 0.90f, rock);
    scores.values[kTerrainSand] *= lerp(1.f, 0.25f, elevation) * (1.f - rockExclusion);
    scores.values[kTerrainGrass] *= 1.f - rockExclusion;
    scores.values[kTerrainDeadGrass] *= 1.f - rockExclusion * 0.9f;
    scores.values[kTerrainRock] *= lerp(0.4f, 1.f, rock);
    scores.values[kTerrainDirt] *= lerp(0.5f, 1.f, elevation) * (1.f - rockExclusion * 0.85f);
    float total = 0.f;
    for (uint layer = 0; layer < kTerrainBlendMaskLayerCount; ++layer) {
      total += scores.values[layer];
    }
    const float paletteWeight = confidence * args.paletteStrength * (1.f - rockExclusion * 0.80f);
    if (total > 0.f && paletteWeight > 0.f) {
      for (uint layer = 0; layer < kTerrainBlendMaskLayerCount; ++layer) {
        weights.values[layer] = lerp(weights.values[layer], scores.values[layer] / total, paletteWeight);
      }
    }
  }

  terrainFinishBaseWeights(args, position, worldElevation, abs(dot(normal, up)), weights);
  return weights;
}

TerrainWeights terrainPlacementWeights(TerrainWeights weights, vec3 position, vec3 normal, float lod) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  if (args.heightBlendStrength <= 0.f) {
    return weights;
  }
  float scores[kTerrainBlendLayerCount];
  float maxScore = -1e9f;
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    const float weight = weights.values[layer];
    if (weight > 0.f) {
      const float height = terrainLayerHeight(args.layers[layer], position, normal, lod);
      // Taper height influence for trace weights so absent layers cannot pop through as specks.
      const float heightMask = smoothstep(0.f, 0.25f, weight);
      scores[layer] = weight + height * args.heightBlendStrength * heightMask;
      maxScore = max(maxScore, scores[layer]);
    } else {
      scores[layer] = -1e9f;
    }
  }
  const float floorScore = maxScore - max(args.heightBlendWidth, 1e-3f);
  float sum = 0.f;
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    weights.values[layer] = max(scores[layer] - floorScore, 0.f);
    sum += weights.values[layer];
  }
  if (sum > 0.f) {
    const float invSum = rcp(sum);
    for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
      weights.values[layer] *= invSum;
    }
  }
  return weights;
}

#if defined(TERRAIN_BLEND) || defined(TERRAIN_BLEND_SHADOW)
vec2 terrainReliefBounds(TerrainWeights weights) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  vec2 bounds = vec2(0.f);
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    if (args.layers[layer].heightTextureIndex != BINDING_INDEX_INVALID) {
      bounds += weights.values[layer] * args.layers[layer].relief.xy;
    }
  }
  return vec2(-bounds.x, bounds.y) * args.displacementStrength;
}

TerrainWeights terrainScaleWeights(TerrainWeights weights, float scale) {
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    weights.values[layer] *= scale;
  }
  return weights;
}

float terrainReliefHeight(vec3 position, vec3 normal, TerrainWeights weights, float lod) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  float height = 0.f;
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    if (weights.values[layer] <= 0.f || args.layers[layer].heightTextureIndex == BINDING_INDEX_INVALID) {
      continue;
    }
    const float source = terrainLayerHeight(args.layers[layer], position, normal, lod);
    const float remapped = saturate((source - args.layers[layer].relief.z) /
      (args.layers[layer].relief.w - args.layers[layer].relief.z));
    height += weights.values[layer] * (remapped * (args.layers[layer].relief.x + args.layers[layer].relief.y) -
      args.layers[layer].relief.x);
  }
  return sanitize(height * args.displacementStrength, 0.f);
}

void terrainQuadtreeCell(vec3 position, vec3 direction, vec3 normal, TerrainWeights weights, uint level, uint minimumLevel,
    out float maximumHeight, out float exitDistance) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  const vec3 projections = terrainProjectionWeights(normal);
  maximumHeight = 0.f;
  exitDistance = 1e30f;
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    const TerrainBlendLayerArgs material = args.layers[layer];
    if (weights.values[layer] <= 0.f || material.heightTextureIndex == BINDING_INDEX_INVALID) {
      continue;
    }
    uint width, height, mipCount;
    textures[nonuniformEXT(material.heightTextureIndex)].GetDimensions(0, width, height, mipCount);
    const uint mip = min(level, mipCount - 1);
    const int2 dimensions = int2(max(uint2(width, height) >> mip, uint2(1)));
    float layerMaximum = 0.f;
    for (uint axis = 0; axis < 3; ++axis) {
      if (projections[axis] == 0.f) {
        continue;
      }
      vec3 tangent, bitangent;
      terrainProjectionBasis(normal, axis, tangent, bitangent);
      const vec2 uv = vec2(dot(position, tangent), dot(position, bitangent)) / material.unitsPerRepeat;
      const vec2 velocity = vec2(dot(direction, tangent), dot(direction, bitangent)) / material.unitsPerRepeat;
      const float gridOffset = level == minimumLevel ? 0.5f : 0.f;
      const int2 cell = int2(floor(uv * dimensions - gridOffset));
      float projectionMaximum = 0.f;
      // Neighbour maxima bound the bilinear footprint throughout the current cell.
      if (level > minimumLevel) {
        for (int x = -1; x <= 1; ++x) {
          for (int y = -1; y <= 1; ++y) {
            const int2 texel = ((cell + int2(x, y)) % dimensions + dimensions) % dimensions;
            projectionMaximum = max(projectionMaximum,
              textures[nonuniformEXT(material.heightTextureIndex)].Load(int3(texel, mip)).r);
          }
        }
      }
      layerMaximum += projections[axis] * projectionMaximum;
      for (uint coordinate = 0; coordinate < 2; ++coordinate) {
        if (abs(velocity[coordinate]) > 1e-8f) {
          const float edge = (float(cell[coordinate] + (velocity[coordinate] > 0.f ? 1 : 0)) + gridOffset) /
            float(dimensions[coordinate]);
          const float distance = (edge - uv[coordinate]) / velocity[coordinate];
          // Cross the boundary even when world-space coordinates limit float precision.
          const float boundaryStep = max(0.001f / float(dimensions[coordinate]),
            abs(uv[coordinate]) * 2e-7f) / abs(velocity[coordinate]);
          exitDistance = min(exitDistance, max(distance, boundaryStep));
        }
      }
    }
    const float remapped = saturate((layerMaximum - args.layers[layer].relief.z) /
      (args.layers[layer].relief.w - args.layers[layer].relief.z));
    maximumHeight += weights.values[layer] * (remapped *
      (args.layers[layer].relief.x + args.layers[layer].relief.y) - args.layers[layer].relief.x);
  }
  maximumHeight *= args.displacementStrength;
}

// Each layer can cross two remap thresholds twice, plus the shared interval endpoints.
static const uint kTerrainMaxBreakpoints = 2 + 4 * kTerrainBlendLayerCount;

void terrainAppendHeightBreakpoints(vec3 polynomial, float threshold, inout float breakpoints[kTerrainMaxBreakpoints], inout uint count) {
  float first, second;
  const int roots = terrainPomRoots(polynomial.x, polynomial.y, polynomial.z - threshold, first, second);
  if (roots > 0 && first > 0.f && first < 1.f) {
    breakpoints[count++] = first;
  }
  if (roots > 1 && second > 0.f && second < 1.f) {
    breakpoints[count++] = second;
  }
}

bool terrainQuadtreeLeafIntersection(vec3 position, vec3 normal, vec3 outwardView, TerrainWeights weights, float lod,
    float startDistance, float endDistance, out float intersection) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  vec3 polynomials[kTerrainBlendLayerCount];
  float breakpoints[kTerrainMaxBreakpoints];
  breakpoints[0] = 0.f;
  breakpoints[1] = 1.f;
  uint count = 2;
  intersection = 0.f;
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    polynomials[layer] = vec3(0.f);
    if (weights.values[layer] <= 0.f || args.layers[layer].heightTextureIndex == BINDING_INDEX_INVALID) {
      continue;
    }
    const float first = terrainLayerHeight(args.layers[layer], position + outwardView * startDistance, normal, lod);
    const float middle = terrainLayerHeight(args.layers[layer],
      position + outwardView * (0.5f * (startDistance + endDistance)), normal, lod);
    const float last = terrainLayerHeight(args.layers[layer], position + outwardView * endDistance, normal, lod);
    const float curvature = 2.f * (first + last - 2.f * middle);
    polynomials[layer] = vec3(curvature, last - first - curvature, first);
    terrainAppendHeightBreakpoints(polynomials[layer], args.layers[layer].relief.z, breakpoints, count);
    terrainAppendHeightBreakpoints(polynomials[layer], args.layers[layer].relief.w, breakpoints, count);
  }
  for (uint index = 1; index < count; ++index) {
    const float value = breakpoints[index];
    uint destination = index;
    while (destination > 0 && breakpoints[destination - 1] > value) {
      breakpoints[destination] = breakpoints[destination - 1];
      --destination;
    }
    breakpoints[destination] = value;
  }
  const float facing = dot(outwardView, normal);
  for (uint segment = 1; segment < count; ++segment) {
    const float lower = breakpoints[segment - 1];
    const float upper = breakpoints[segment];
    const float middle = 0.5f * (lower + upper);
    vec3 gapPolynomial = vec3(0.f, (endDistance - startDistance) * facing, startDistance * facing);
    for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
      if (weights.values[layer] <= 0.f || args.layers[layer].heightTextureIndex == BINDING_INDEX_INVALID) {
        continue;
      }
      const vec3 raw = polynomials[layer];
      const float height = dot(raw, vec3(middle * middle, middle, 1.f));
      vec3 relief;
      if (height <= args.layers[layer].relief.z) {
        relief = vec3(0.f, 0.f, -args.layers[layer].relief.x);
      } else if (height >= args.layers[layer].relief.w) {
        relief = vec3(0.f, 0.f, args.layers[layer].relief.y);
      } else {
        const float scale = (args.layers[layer].relief.x + args.layers[layer].relief.y) /
          (args.layers[layer].relief.w - args.layers[layer].relief.z);
        relief = raw * scale;
        relief.z -= args.layers[layer].relief.z * scale + args.layers[layer].relief.x;
      }
      gapPolynomial -= relief * (weights.values[layer] * args.displacementStrength);
    }
    float fraction;
    if (terrainPomFirstRoot(gapPolynomial.x, gapPolynomial.y, gapPolynomial.z, lower, upper, fraction)) {
      intersection = sanitize(lerp(startDistance, endDistance, fraction), 0.f);
      return true;
    }
  }
  return false;
}

bool terrainQuadtreeIntersection(vec3 position, vec3 normal, vec3 outwardView, TerrainWeights weights, float lod,
    out float intersection) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  const float facing = dot(outwardView, normal);
  const vec2 bounds = terrainReliefBounds(weights);
  intersection = 0.f;
  if (facing <= 1e-4f || bounds.y <= bounds.x) {
    return false;
  }
  uint maximumLevel = 0;
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    if (weights.values[layer] > 0.f && args.layers[layer].heightTextureIndex != BINDING_INDEX_INVALID) {
      uint width, height, mipCount;
      textures[nonuniformEXT(args.layers[layer].heightTextureIndex)].GetDimensions(0, width, height, mipCount);
      maximumLevel = max(maximumLevel, mipCount - 1);
    }
  }
  const uint minimumLevel = min(uint(max(floor(lod), 0.f)), maximumLevel);
  // Explicit sampling still applies the terrain sampler's DLSS mip bias.
  const float leafLod = float(minimumLevel) - cb.totalMipBias;
  uint level = max(maximumLevel / 2, minimumLevel);
  float distance = bounds.y / facing;
  const float endDistance = bounds.x / facing;
  const float previousGap = distance * facing - terrainReliefHeight(position + outwardView * distance, normal, weights, leafLod);
  if (previousGap <= 0.f) {
    intersection = distance;
    return true;
  }
  for (uint iteration = 0; iteration < args.displacementMaxIterations && distance > endDistance; ++iteration) {
    float maximumHeight, cellExit;
    terrainQuadtreeCell(position + outwardView * distance, -outwardView, normal, weights, level, minimumLevel,
      maximumHeight, cellExit);
    const float nextDistance = max(endDistance, distance - cellExit);
    if (level > minimumLevel && nextDistance * facing <= maximumHeight) {
      --level;
      continue;
    }
    if (level == minimumLevel && terrainQuadtreeLeafIntersection(position, normal, outwardView, weights, leafLod,
        distance, nextDistance, intersection)) {
      return true;
    }
    distance = nextDistance;
    level = min(level + 1, maximumLevel);
  }
  return false;
}

float terrainBlendShadowThroughput(MinimalSurfaceInteraction interaction, vec3 lightDirection,
    vec3 outwardViewDirection, vec4 terrainHitData) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  if (!args.enabled || !args.displacementEnabled || !args.displacementSelfShadowEnabled ||
      args.displacementShadowStrength <= 0.f || args.displacementStrength <= 0.f) {
    return 1.f;
  }
  const vec3 normal = interaction.geometryNormal;
  const float facing = dot(normal, lightDirection);
  if (facing <= 1e-4f) {
    return 1.f;
  }
  const vec3 anchor = interaction.position + args.worldOffset.xyz;
  const float placementLod = max(terrainHitData.y, 0.f);
  const float lod = floor(placementLod) - cb.totalMipBias;
  const float grazingFade = smoothstep(0.05f, 0.2f, dot(outwardViewDirection, normal));
  const TerrainWeights baseWeights = terrainBaseWeights(anchor, normal, terrainHitData.w);
  const TerrainWeights weights = terrainScaleWeights(terrainPlacementWeights(baseWeights, anchor, normal, placementLod), grazingFade);
  const vec3 virtualHit = anchor + outwardViewDirection * terrainHitData.x;
  const vec2 bounds = terrainReliefBounds(weights);
  const float surfaceHeight = terrainReliefHeight(virtualHit, normal, weights, lod);
  const float remaining = bounds.y - surfaceHeight;
  if (remaining <= 0.f) {
    return 1.f;
  }
  // Compare against the sampled origin height so interpolation error cannot shadow a flat field.
  const float epsilon = max(1e-5f, (bounds.y - bounds.x) * 1e-5f);
  const float rayLength = remaining / facing;
  for (uint step = 1; step <= args.displacementShadowMaxIterations; ++step) {
    const float distance = rayLength * float(step) / float(args.displacementShadowMaxIterations);
    const float rayHeight = surfaceHeight + facing * distance;
    if (terrainReliefHeight(virtualHit + lightDirection * distance, normal, weights, lod) > rayHeight + epsilon) {
      return 1.f - args.displacementShadowStrength;
    }
  }
  return 1.f;
}
#endif

#ifdef TERRAIN_BLEND
struct TerrainLayerSample {
  vec3 albedo;
  vec3 normal;
  float roughness;
};

vec4 terrainSampleTexture(uint textureIndex, uint samplerIndex, vec2 uv, vec2 dx, vec2 dy, vec4 fallback) {
  if (textureIndex == BINDING_INDEX_INVALID) {
    return fallback;
  }
  return textures[nonuniformEXT(textureIndex)].SampleGrad(samplers[nonuniformEXT(samplerIndex)], uv, dx, dy);
}

float terrainSamplePalette(OpaqueSurfaceMaterial material, SurfaceInteraction interaction) {
  if (cb.terrainBlendArgs.paletteStrength <= 0.f || material.albedoOpacityTextureIndex == BINDING_INDEX_INVALID) {
    return 0.f;
  }
  vec3 color = terrainSampleTexture(material.albedoOpacityTextureIndex, material.samplerIndex,
    interaction.textureCoordinates, interaction.textureGradientX, interaction.textureGradientY, vec4(0.f)).rgb;
  if (material.flags & OPAQUE_SURFACE_MATERIAL_FLAG_ALBEDO_TEXTURE_IS_SRGB) {
    color = linearToGamma(color);
  }
  const uvec3 rgb = uvec3(round(saturate(color) * 255.f));
  // A 24-bit integer is exact in the float attachment shared with the relief shadow passes.
  return float((rgb.r << 16) | (rgb.g << 8) | rgb.b);
}

float terrainControlLod(SurfaceInteraction interaction, TerrainBlendArgs args) {
  uint width, height;
  textures[nonuniformEXT(args.controlTextureIndex)].GetDimensions(width, height);
  const vec2 texelScale = abs(args.controlWorldToUv.xy) * vec2(width, height);
  const vec3 gradientX = interaction.worldPositionGradientX;
  const vec3 gradientY = interaction.worldPositionGradientY;
  const vec2 dx = (args.zUp ? gradientX.xy : gradientX.xz) * texelScale;
  const vec2 dy = (args.zUp ? gradientY.xy : gradientY.xz) * texelScale;
  return max(0.f, 0.5f * log2(max(max(dot(dx, dx), dot(dy, dy)), 1.f)));
}

float terrainHeightLod(SurfaceInteraction interaction, TerrainWeights baseWeights) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  float footprintSquared = 0.f;
  const vec3 projections = terrainProjectionWeights(interaction.geometryNormal);
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    if (baseWeights.values[layer] <= 0.f ||
        args.layers[layer].heightTextureIndex == BINDING_INDEX_INVALID) {
      continue;
    }
    uint width, height;
    textures[nonuniformEXT(args.layers[layer].heightTextureIndex)].GetDimensions(width, height);
    for (uint axis = 0; axis < 3; ++axis) {
      if (projections[axis] == 0.f) {
        continue;
      }
      vec3 tangent, bitangent;
      terrainProjectionBasis(interaction.geometryNormal, axis, tangent, bitangent);
      const vec2 texelScale = vec2(width, height) / args.layers[layer].unitsPerRepeat;
      const vec2 dx = vec2(dot(interaction.worldPositionGradientX, tangent), dot(interaction.worldPositionGradientX, bitangent)) * texelScale;
      const vec2 dy = vec2(dot(interaction.worldPositionGradientY, tangent), dot(interaction.worldPositionGradientY, bitangent)) * texelScale;
      footprintSquared = max(footprintSquared, max(dot(dx, dx), dot(dy, dy)));
    }
  }
  // One explicit LOD is retained with the virtual hit and reused by every shadow march.
  return max(0.f, 0.5f * log2(max(footprintSquared, 1e-8f)) + cb.totalMipBias);
}

TerrainLayerSample terrainSampleLayer(TerrainBlendLayerArgs layer, SurfaceInteraction interaction, vec3 position) {
  const vec3 n = interaction.geometryNormal;
  const vec3 projectionWeights = terrainProjectionWeights(n);
  const float scale = rcp(max(layer.unitsPerRepeat, 1e-4f));
  TerrainLayerSample result;
  result.albedo = 0.f;
  result.normal = n;
  result.roughness = 0.f;
  for (uint axis = 0; axis < 3; ++axis) {
    const float weight = projectionWeights[axis];
    if (weight == 0.f) {
      continue;
    }
    vec3 tangent, bitangent;
    terrainProjectionBasis(n, axis, tangent, bitangent);
    const vec2 uv = vec2(dot(position, tangent), dot(position, bitangent)) * scale;
    const vec2 dx = vec2(dot(interaction.worldPositionGradientX, tangent), dot(interaction.worldPositionGradientX, bitangent)) * scale;
    const vec2 dy = vec2(dot(interaction.worldPositionGradientY, tangent), dot(interaction.worldPositionGradientY, bitangent)) * scale;
    vec3 albedo = terrainSampleTexture(layer.albedoTextureIndex, layer.samplerIndex, uv, dx, dy, layer.albedoConstant).rgb;
    if (layer.albedoTextureIndex == BINDING_INDEX_INVALID || layer.albedoIsSrgb == 0) {
      albedo = gammaToLinear(albedo);
    }
    result.albedo += albedo * weight;
    result.roughness += terrainSampleTexture(layer.roughnessTextureIndex, layer.samplerIndex, uv, dx, dy, vec4(layer.roughnessConstant)).r * weight;
    if (layer.normalTextureIndex != BINDING_INDEX_INVALID) {
      const vec2 encoded = terrainSampleTexture(layer.normalTextureIndex, layer.samplerIndex, uv, dx, dy, vec4(0.f)).xy;
      const vec3 detail = unsignedOctahedralToHemisphereDirection(encoded, cb.opaqueMaterialArgs.normalIntensity);
      result.normal += weight * (tangent * detail.x + bitangent * detail.y + n * (detail.z - 1.f));
    }
  }
  result.normal = normalize(result.normal);
  return result;
}

void terrainApplyGeoStrata(TerrainBlendArgs args, TerrainWeights weights, SurfaceInteraction interaction,
    vec3 position, float rockHeight, inout vec3 albedo, inout vec3 normal, inout float roughness) {
  const float exposedRock = weights.values[kTerrainRock] + weights.values[kTerrainPeakRockLayer] +
    0.25f * weights.values[kTerrainLowerRockLayer];
  const float exposedGround = saturate(exposedRock + 0.10f * weights.values[kTerrainDirt]);
  if (args.geoTextureIndex == BINDING_INDEX_INVALID || args.geoStrength <= 0.f || exposedGround <= 0.f) {
    return;
  }
  const uint vertical = args.zUp ? 2u : 1u;
  const float sign = args.flipElevation ? -1.f : 1.f;
  const float scale = rcp(args.geoMaxElevation - args.geoMinElevation);
  // Break up contour-line regularity using local rock relief so strata follow fracture blocks.
  float elevation = position[vertical] * sign + (rockHeight - 0.5f) * 0.95f;
  float dx = interaction.worldPositionGradientX[vertical] * sign;
  float dy = interaction.worldPositionGradientY[vertical] * sign;
  vec2 dipGradient = vec2(0.f);
  if (args.geoDipAmplitude > 0.f) {
    const vec2 plane = args.zUp ? position.xy : position.xz;
    const float frequency = 6.2831853f / args.geoDipPeriod;
    const vec2 waveA = frequency * vec2(0.82f, 0.56f);
    const vec2 waveB = frequency * vec2(-0.48f, 1.27f);
    const vec2 waveC = frequency * vec2(2.15f, -1.65f);
    const float phaseA = dot(plane, waveA);
    const float phaseB = dot(plane, waveB) + 2.13f;
    const float phaseC = dot(plane, waveC) + 0.71f;
    elevation += args.geoDipAmplitude * (0.58f * sin(phaseA) + 0.28f * sin(phaseB) + 0.14f * sin(phaseC));
    dipGradient = args.geoDipAmplitude * (0.58f * cos(phaseA) * waveA + 0.28f * cos(phaseB) * waveB + 0.14f * cos(phaseC) * waveC);
    dx += dot(dipGradient, args.zUp ? interaction.worldPositionGradientX.xy : interaction.worldPositionGradientX.xz);
    dy += dot(dipGradient, args.zUp ? interaction.worldPositionGradientY.xy : interaction.worldPositionGradientY.xz);
  }
  const float u = (elevation - args.geoMinElevation) * scale;
  if (u < 0.f || u > 1.f) {
    return;
  }
  const float slope = 1.f - abs(interaction.geometryNormal[vertical]);
  // Expose sedimentary bedding clearly on mountain faces (~16-36 deg) while keeping flat domes free of contour rings.
  const float cliffExposure = smoothstep(0.035f, 0.19f, slope);
  const float peakAttenuation = lerp(1.f, 0.42f, weights.values[kTerrainPeakRockLayer]);
  const float strength = args.geoStrength * exposedGround * peakAttenuation * lerp(0.10f, 1.f, cliffExposure);
  const vec4 tint = terrainSampleTexture(args.geoTextureIndex, args.maskSamplerIndex, vec2(u, 0.5f),
    vec2(dx * scale, 0.f), vec2(dy * scale, 0.f), vec4(0.5f, 0.5f, 0.5f, 0.f));
  const float mask = saturate(strength * tint.a);
  if (mask <= 0.f) {
    return;
  }
  // Linear-space Multiply2x: sRGB 0.5 maps to linear 1.0 via 2^2.2 (4.5947938).
  const vec3 strataLinear = gammaToLinear(saturate(tint.rgb)) * 4.5947938f;
  albedo *= lerp(vec3(1.f), strataLinear, mask);

  uint geoWidth, geoHeight;
  textures[nonuniformEXT(args.geoTextureIndex)].GetDimensions(geoWidth, geoHeight);
  const float du = 2.f / max(float(geoWidth), 1.f);
  const vec3 hi = terrainSampleTexture(args.geoTextureIndex, args.maskSamplerIndex, vec2(min(u + du, 1.f), 0.5f),
    vec2(dx * scale, 0.f), vec2(dy * scale, 0.f), vec4(0.5f)).rgb;
  const vec3 lo = terrainSampleTexture(args.geoTextureIndex, args.maskSamplerIndex, vec2(max(u - du, 0.f), 0.5f),
    vec2(dx * scale, 0.f), vec2(dy * scale, 0.f), vec4(0.5f)).rgb;
  const vec3 lumaWeights = vec3(0.2126f, 0.7152f, 0.0722f);
  const float strataLuma = dot(tint.rgb, lumaWeights);
  const float strataDelta = dot(hi - lo, lumaWeights);
  vec3 strataGradient = args.zUp ? vec3(dipGradient.x, dipGradient.y, sign) : vec3(dipGradient.x, sign, dipGradient.y);
  strataGradient = normalize(strataGradient);
  vec3 strataTangent = strataGradient - dot(strataGradient, interaction.geometryNormal) * interaction.geometryNormal;
  const float tangentLenSq = dot(strataTangent, strataTangent);
  if (tangentLenSq > 1e-5f) {
    strataTangent *= rsqrt(tangentLenSq);
    normal = normalize(normal - strataTangent * (strataDelta * 0.78f * mask));
  }
  roughness = saturate(roughness * lerp(1.f, lerp(1.12f, 0.88f, strataLuma), mask * 0.65f));
}

OpaqueSurfaceMaterialInteraction terrainBlendInteractionCreate(OpaqueSurfaceMaterial material, Surface surface,
    inout SurfaceInteraction interaction, MinimalRayInteraction ray) {
  const TerrainBlendArgs args = cb.terrainBlendArgs;
  const vec3 position = interaction.position + args.worldOffset.xyz;
  interaction.terrainPaletteSample = args.controlTextureIndex != BINDING_INDEX_INVALID
    ? terrainControlLod(interaction, args) : terrainSamplePalette(material, interaction);
  const TerrainWeights baseWeights = terrainBaseWeights(position, interaction.geometryNormal, interaction.terrainPaletteSample);
  const float lod = args.heightBlendStrength > 0.f || args.displacementEnabled
    ? terrainHeightLod(interaction, baseWeights) : 0.f;
  const TerrainWeights weights = terrainPlacementWeights(baseWeights, position, interaction.geometryNormal, lod);
  vec3 virtualPosition = position;
  bool hasRelief = false;
#ifdef TERRAIN_BLEND
  if (args.displacementEnabled && args.displacementStrength > 0.f && dot(ray.viewDirection, interaction.geometryNormal) > 1e-4f) {
    const float grazingFade = smoothstep(0.05f, 0.2f, dot(ray.viewDirection, interaction.geometryNormal));
    float distance;
    hasRelief = terrainQuadtreeIntersection(position, interaction.geometryNormal, ray.viewDirection,
      terrainScaleWeights(weights, grazingFade), lod, distance);
    if (hasRelief) {
      virtualPosition += ray.viewDirection * distance;
      interaction.textureCoordinates = vec2(distance, lod);
    }
  }
#endif
  vec3 albedo = 0.f;
  vec3 normal = 0.f;
  float roughness = 0.f;
  for (uint layer = 0; layer < kTerrainBlendLayerCount; ++layer) {
    if (weights.values[layer] <= 0.f) {
      continue;
    }
    const TerrainLayerSample sample = terrainSampleLayer(args.layers[layer], interaction, virtualPosition);
    albedo += weights.values[layer] * sample.albedo;
    normal += weights.values[layer] * sample.normal;
    roughness += weights.values[layer] * sample.roughness;
  }
  normal = normalize(normal);
  const float rockHeight = (weights.values[kTerrainRock] + weights.values[kTerrainPeakRockLayer]) > 0.f
    ? terrainLayerHeight(args.layers[kTerrainRock], virtualPosition, interaction.geometryNormal, lod) : 0.5f;
  terrainApplyGeoStrata(args, weights, interaction, virtualPosition, rockHeight, albedo, normal, roughness);
  albedo = saturate(albedo * cb.opaqueMaterialArgs.albedoScale + cb.opaqueMaterialArgs.albedoBias);
  roughness = saturate(roughness * cb.opaqueMaterialArgs.roughnessScale + cb.opaqueMaterialArgs.roughnessBias);
  OpaqueSurfaceMaterialInteraction result = (OpaqueSurfaceMaterialInteraction) 0;
  if (hasRelief) {
    result.flags |= OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_TERRAIN_HEIGHT;
  }
  result.shadingNormal = getBentNormal(interaction.geometryNormal, normal, -ray.viewDirection);
  result.normalDetail = saturate(1.f - dot(interaction.geometryNormal, normal));
  result.opacity = 1.f;
  result.albedo = surface.isMatte ? vec3(0.f) : albedoToAdjustedAlbedo(albedo, 0.f, 1.f);
  result.baseReflectivity = surface.isMatte ? vec3(0.f) : calcBaseReflectivity(albedo, 0.f, 1.f, 0.5f);
  calcRoughness(roughness, 0.f, result.isotropicRoughness, result.anisotropicRoughness);
  return result;
}
#endif
